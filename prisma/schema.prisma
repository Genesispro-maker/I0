generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id String @id @default(cuid())
  username String @unique 
  email String @unique
  passwordHash String
  image String?
  createdAt DateTime? @default(now())
  updatedAt DateTime @updatedAt
  session Sessions[]
  projects Projects[]
  likes Like[]
  forks Fork[]

  @@index([username])
  @@index([email])
}

model Sessions{
  id String @id
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Projects{
  id String @id @default(cuid())
  title String
  visiblity Visiblity @default(PRIVATE)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  messages Message[]
  like Like[]
  forks Fork[] @relation("sourceForks")
  forkOrigin Fork? @relation("forkedFrom")
  status String @default("idle")

  @@index([userId])
  @@index([visiblity])
  @@index([createdAt])
}

