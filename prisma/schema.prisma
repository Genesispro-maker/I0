model Message{
  id String @id @default(cuid())
  content String @db.Text
  reasoning String? @db.Text
  role Role
  projectId String
  project Projects @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime? @default(now())
  generations Generations?

  @@index([projectId])
}
model Generations{
  id String @id @default(cuid())
  files Json
  messageId String @unique
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Like{
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project Projects @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([projectId])
  @@unique([projectId, userId])
  @@index([userId])
}

model Fork {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceId String
  sourceProject Projects @relation("sourceForks", fields: [sourceId], references: [id], onDelete: Cascade)
  forkedId String @unique
  forkedProject Projects @relation("forkedFrom", fields: [forkedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([sourceId])
}

enum Visiblity {
  PRIVATE
  PUBLIC
}

enum Role {
  USER
  ASSISTANT
}